# Copy this file to .env and fill in real values.

# --- Raw pg pool (src/db.js) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartapp
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=4000

# AI teacher & Study Helper (Google Gemini). Get a key at
# https://aistudio.google.com/apikey — never commit a real key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
