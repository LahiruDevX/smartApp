# Copy this file to .env and fill in real values.

# --- Raw pg pool (src/db.js) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartapp
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=4000

# AI teacher & Study Helper (Google Gemini) — chat generation and topic
# classification (backend/src/routes/aiTeacher.js). Get a key at
# https://aistudio.google.com/apikey — never commit a real key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama — only RAG embeddings for course-material search still use this
# (backend/src/rag.js's embed()/embedPending()/retrieve()). OLLAMA_URL is
# used for that embed endpoint; OLLAMA_MODEL was the chat model before the
# Gemini migration above and is currently unused by aiTeacher.js, kept here
# in case you want it again.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
