generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("admin") // admin, teacher, student
  createdAt DateTime @default(now())
}

model SensorReading {
  id        Int      @id @default(autoincrement())
  type      String
  value     Float
  unit      String
  status    String   @default("normal")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([type, createdAt(sort: Desc)], map: "sensor_readings_type_time")
  @@map("sensor_readings")
}

model Device {
  id          String   @id
  title       String
  type        String   @map("device_type")
  isOn        Boolean  @default(false) @map("is_on")
  sliderValue Int?     @map("slider_value")
  online      Boolean  @default(true)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("devices")
}

model Student {
  id              Int                @id @default(autoincrement())
  name            String
  studentCode     String             @unique @map("student_code")
  email           String?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  faceDescriptors FaceDescriptor[]
  attendance      AttendanceRecord[]

  @@map("students")
}

model FaceDescriptor {
  id         Int      @id @default(autoincrement())
  studentId  Int      @map("student_id")
  descriptor Float[]
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId], map: "face_descriptors_student")
  @@map("face_descriptors")
}

model AttendanceRecord {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  method      String   @default("facial")
  status      String   @default("present")
  sessionDate DateTime @default(now()) @map("session_date") @db.Date
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookingId   Int?     @map("booking_id")
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([sessionDate], map: "attendance_records_date")
  @@map("attendance_records")
}

model Booking {
  id                     Int      @id @default(autoincrement())
  title                  String
  teacher                String
  room                   String   @default("Room 301")
  weekday                Int
  startMinute            Int      @map("start_minute")
  endMinute              Int      @map("end_minute")
  enabled                Boolean  @default(true)
  automationEnabled      Boolean  @default(true) @map("automation_enabled")
  fanMode                String   @default("auto") @map("fan_mode")
  fanSpeed               Int      @default(2) @map("fan_speed")
  targetTemperature      Float    @default(26) @map("target_temperature")
  lightOn                Boolean  @default(true) @map("light_on")
  lightBrightness        Int      @default(80) @map("light_brightness")
  attendanceEnabled      Boolean  @default(true) @map("attendance_enabled")
  attendanceGraceMinutes Int      @default(10) @map("attendance_grace_minutes")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  attendance             AttendanceRecord[]

  @@index([weekday, startMinute, endMinute], map: "bookings_day_time")
  @@map("bookings")
}
