# Copy this file to .env and fill in real values.

# --- Prisma (used by prisma migrate / @prisma/client) ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartapp?schema=public"

# --- Raw pg pool (src/db.js, used by /api/devices) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartapp
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Server ---
PORT=4000

# AI teacher (Ollama). Change model here, no code edit needed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
